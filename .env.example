# Copy this file to .env for local runs. In GitHub Actions these are
# provided as repository secrets instead (see .github/workflows/daily.yml).

# --- Editor (LLM) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Mailer: Resend is used when RESEND_API_KEY is set, otherwise SMTP ---
RESEND_API_KEY=re_...

# SMTP fallback (only needed if RESEND_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password

# --- Recipients ---
EMAIL_TO=you@example.com
EMAIL_FROM=Mag <mag@example.com>
