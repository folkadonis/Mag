# Copy this file to .env for local runs. In GitHub Actions these are
# provided as repository secrets instead (see .github/workflows/daily.yml).

# --- Editor (LLM) ---
# No API key is needed by default. With editor.backend = "auto" (config.yaml)
# the pipeline shells out to the Claude Code CLI, which authenticates with
# your Claude Pro/Max subscription. Just make sure `claude` is installed and
# you have logged in once by running `claude` interactively.
#
# Only set this if you deliberately want the metered pay-as-you-go API
# instead (config.yaml -> editor.backend: "api"):
# ANTHROPIC_API_KEY=sk-ant-...

# --- Mailer: Resend is used when RESEND_API_KEY is set, otherwise SMTP ---
# RESEND_API_KEY=re_...

# Gmail SMTP. SMTP_PASS must be a 16-character Google App Password, NOT your
# normal Google password. Generate one at:
#   https://myaccount.google.com/apppasswords
# (2-Step Verification has to be enabled on the account first.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=abcdefghijklmnop

# --- Recipients ---
EMAIL_TO=you@gmail.com
# Optional. Defaults to "Mag <SMTP_USER>", which is what Gmail requires.
# EMAIL_FROM=Mag <you@gmail.com>
